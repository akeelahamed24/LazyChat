# ──────────────────────────────────────────────────────────────
#  Omnia — environment variables
#  Copy to .env and fill in what you use. All values are optional;
#  the app works with any subset of providers.
# ──────────────────────────────────────────────────────────────

# --- OpenCode Zen (one key for GPT, Claude, Gemini + open models) ----
# Sign in at https://opencode.ai/auth, add billing, and copy your API key.
# Full model list: https://opencode.ai/zen/v1/models
OPENCODE_API_KEY=

# Optional: override the Zen API root (defaults to https://opencode.ai/zen/v1).
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Anthropic (Claude) ----------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI -----------------------------------------------------
OPENAI_API_KEY=

# --- Google Gemini ----------------------------------------------
GOOGLE_API_KEY=

# --- Ollama (local, http://127.0.0.1:11434) ---------------------
# Optional: only if you run Ollama somewhere else.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- LM Studio (local, http://127.0.0.1:1234) -------------------
# Optional: only if you run LM Studio somewhere else.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# --- Docker sandbox service -------------------------------------
# URL of the sandbox service (sandbox/server.mjs). The Next.js app
# proxies to it. Defaults to http://127.0.0.1:8787.
# SANDBOX_URL=http://127.0.0.1:8787

# Docker image used for agent sandboxes (build with: npm run sandbox:build)
# SANDBOX_IMAGE=omnia-sandbox:latest

# --- Company Brain (FalkorDB memory + graph agent) -----------------
# The brain backend lives inside this app (app/api/brain/*, lib/brain/*).
# Only FalkorDB needs to be reachable. Without an LLM key the deterministic
# mock planner answers from the graph offline.
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_GRAPH_NAME=company_brain
# FALKORDB_PASSWORD=

# Brain LLM provider: sarvam | anthropic | mock (default: sarvam key if set,
# else anthropic key if set, else mock). LLM_FORCE_MOCK=1 forces the mock.
# LLM_PROVIDER=
# LLM_FORCE_MOCK=

# --- Sarvam (sarvam-105b, OpenAI-compatible, no native function calling) ---
# SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-105b

# --- Storage ----------------------------------------------------
# Files (artifacts, uploads, conversations, skills, MCP servers)
# are stored under ./data by default. Override if you like.
# DATA_DIR=./data

# --- Firebase (Auth + Firestore) ---------------------------------
# Web app config from Firebase Console > Project settings. Put real values in .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The only account that can open /admin. Create it once with `npm run seed:admin`.
SUPER_ADMIN_EMAIL=
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=
# Used only by scripts/seed-super-admin.mjs; never read by the app.
SUPER_ADMIN_PASSWORD=

# Shared secret for harness agents calling the local MCP endpoints (random hex).
OMNIA_INTERNAL_TOKEN=
# Shared secret between the Next app and sandbox/server.mjs.
SANDBOX_SECRET=

# --- NVIDIA NIM (OpenAI-compatible; Nemotron, Kimi, DeepSeek, gpt-oss) ---
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# FALKORDB_USERNAME=
# FALKORDB_TLS=false
