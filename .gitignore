# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sandbox workspace volumes
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Hackathon backend
backend/.venv/
backend/.uv-cache/
backend/.env
__pycache__/

# secrets
.env
.env.*
!.env.example

# DeepSeek Harness (vendored checkout; see README — clone, not tracked)
harness/

# HyperFrames (vendored git repo; not tracked)
hyperframes/

# Build artifacts and caches
.bun/
.npm/
.local/
.commandcode/
.hyperframes/
.config/
.npmrc

# Compositions work/temp directories (keep source compositions only)
compositions/work-*/
compositions/.out.hf-transaction-*
compositions/.hyperframes/

# Qt desktop wrapper (superseded — Omnia is a pure Next.js web app)
Desktop/
