    "test:ui": "tsx --test tests/ui/tool-view.test.ts && tsx --test tests/ui/ask-user.test.ts",
    "seed:admin": "node scripts/seed-super-admin.mjs",
    "test:auth": "tsx --test tests/unit/auth.test.ts tests/unit/chat-store.test.ts tests/unit/sse.test.ts tests/unit/genui.test.ts tests/unit/genui-stream.test.ts tests/unit/documents.test.ts",
    "prepare:prefab": "node scripts/copy-prefab.mjs",
    "genui:catalog": "node scripts/build-prefab-catalog.mjs",
    "postinstall": "node scripts/copy-prefab.mjs",
    "test:e2e:genui": "tsx scripts/e2e-prefab.mjs"
